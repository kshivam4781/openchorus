# Copy to .env and edit. Every setting is optional.

# auto = ACE-Step when reachable, otherwise the offline demo synth
OPENCHORUS_ENGINE=auto

# ACE-Step 1.5 REST API (uv run acestep-api)
ACESTEP_URL=http://127.0.0.1:8001
ACESTEP_API_KEY=
# e.g. acestep-v15-turbo, acestep-v15-sft, acestep-v15-xl-turbo (empty = server default)
ACESTEP_MODEL=
ACESTEP_THINKING=true
# 8 for turbo models, 32-64 for base/sft
ACESTEP_STEPS=8

# Local LLM (Ollama) that writes lyrics, production briefs and cover prompts.
# auto = use Ollama when it is running, acestep = always use ACE-Step's own planner
OPENCHORUS_PLANNER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
# Vision model for "Use a picture"
OLLAMA_VISION_MODEL=llava:7b

# Master every take to streaming loudness
OPENCHORUS_MASTERING=true
OPENCHORUS_MASTER_LUFS=-14

# Optional AI service (cover art, quality judge, lyric clarity, 4-stem split)
AUX_URL=http://127.0.0.1:8002

OPENCHORUS_HOST=127.0.0.1
OPENCHORUS_PORT=7777
# Library database, audio and covers
OPENCHORUS_DATA=./data
